# 이 파일을 .env 로 복사해 값을 채운다. .env 는 절대 커밋하지 않는다.
# 값이 비어 있어도 서버는 뜬다 — 대신 /api/health 가 어떤 모드인지 알려준다.

# ── OpenAI ────────────────────────────────────────
# 없으면 AI 답변 대신 규칙 기반 계산 결과를 돌려준다(가짜 답을 만들지 않기 위해).
OPENAI_API_KEY=
# OpenAI 호환 프록시를 쓸 때만 지정한다.
#   Codyssey 과정 게이트웨이 → https://copa.codyssey.kr/v1
#   비워 두면 SDK 기본값(api.openai.com)으로 나간다.
#   ⚠️ 프록시용 virtual-key 를 쓰면서 이걸 비우면 401 이 난다.
OPENAI_BASE_URL=
# 게이트웨이에서 쓸 수 있는 CHAT 모델 예: gpt-5-mini / claude-haiku-4 / gemini-3.1-flash-lite
OPENAI_MODEL=gpt-5-mini
# 과제 7절: 개발 중 토큰 상한을 둔다.
OPENAI_MAX_TOKENS=800

# ── Firebase Firestore ────────────────────────────
# 서비스 계정 키 JSON '전체'를 한 줄 문자열로 넣는다.
# Render 는 파일 업로드가 번거로워 환경 변수로 받는 편이 낫다.
# 없으면 메모리 저장으로 떨어지고, 재시작하면 데이터가 사라진다.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_COLLECTION_DATA=data
FIRESTORE_COLLECTION_CONVERSATIONS=conversations

# ── CORS ──────────────────────────────────────────
# 배포 시 Vercel 주소로 좁힌다. 예: https://my-app.vercel.app
ALLOWED_ORIGINS=*

# ── 데이터 소스 ───────────────────────────────────
# 실제 RADAR 저장소 경로. 비우면 sample 어댑터만 쓴다. 읽기 전용으로만 접근한다.
RADAR_ROOT=
# 결정을 RADAR data/decisions.jsonl 에 append 한다(결정의 단일 정본). 실측 후보에만 쓴다. 명시적으로 켜야 한다.
RADAR_DECISIONS_WRITE=
# MAKE 인계 시 RADAR automaker_intake.send() 가 보낼 AutoMaker 주소(루프백만 허용). 기본 http://127.0.0.1:5300
AUTOMAKER_URL=
# RADAR 코드를 돌릴 인터프리터. RADAR.cmd 가 쓰는 것과 같아야 한다(pandas 등). 기본 python
RADAR_PYTHON=
# SAMPLE_DATA_PATH, HANDOFF_DIR 는 기본값(프로젝트 내부)을 쓰면 된다.

# ── 진단 ──────────────────────────────────────────
# true 로 두면 /api/chat/preview 가 열려 주입될 System Prompt 전문을 볼 수 있다.
# 내부 지시문과 후보 데이터가 그대로 나오므로 **운영에서는 반드시 비워 둔다.**
DEBUG=
