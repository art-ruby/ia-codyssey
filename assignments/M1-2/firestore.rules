rules_version = '2';

// AI Secretary: 브라우저(Firebase 웹 SDK)의 직접 읽기·쓰기를 전면 거부한다.
// 모든 데이터 접근은 서버(FastAPI)의 Admin SDK를 거치며, Admin SDK는 이 규칙과 무관하다.
// 소유자·모드 확인은 서버의 저장소 계층(server/app/core/firestore.py)이 맡는다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
