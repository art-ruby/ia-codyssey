# 로컬 개발: 이 파일을 같은 폴더의 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.
# 배포(Render·Vercel)에서는 각 서비스의 환경변수로 입력한다.

# ── 서버: AI (Codyssey 프록시, OpenAI 호환 · T01.03에서 검증) ──
OPENAI_API_KEY=
AI_PROVIDER_BASE_URL=https://copa.codyssey.kr/v1
AI_PROVIDER_MODEL=
# 비우면 기본값 사용: 일 50회 · 출력 1500토큰 · 60초 (PRD §14 초기 가설)
AI_DAILY_REQUEST_LIMIT=
AI_MAX_OUTPUT_TOKENS=
AI_TIMEOUT_SECONDS=

# ── 서버: Firebase · 단일 소유자 ──
FIREBASE_SERVICE_ACCOUNT_JSON=
OWNER_UID=

# ── 서버: CORS (쉼표로 구분한 허용 도메인) ──
ALLOWED_ORIGINS=

# ── 웹 공개 설정: 빌드·배포 과정에서 주입 (브라우저가 서버 환경변수를 읽지 않음) ──
API_BASE_URL=
