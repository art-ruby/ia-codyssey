# 로컬 개발: 이 파일을 같은 폴더의 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.
# 배포(Render·Vercel)에서는 각 서비스의 환경변수로 입력한다.

# ── 서버: AI (로컬 개발은 Hermes API, Render는 Hermes 중계 토큰) ──
# 로컬 OPENAI_API_KEY는 Hermes API_SERVER_KEY다. Render의 같은 변수에는 HERMES_RELAY_TOKEN을 설정한다.
# Hermes 구독 계정 자격증명은 이 파일이나 Render에 넣지 않는다.
OPENAI_API_KEY=
AI_PROVIDER_BASE_URL=http://127.0.0.1:8642/v1
AI_PROVIDER_MODEL=gpt-6-luna
AI_PROVIDER_ROUTE=openai-codex
# 로컬 중계 서버가 Funnel 요청을 인증하는 별도 무작위 토큰. Hermes API 키와 다르게 생성한다.
HERMES_RELAY_TOKEN=
# 비우면 기본값 사용: 일 50회 · 출력 1500토큰. 로컬 Hermes는 120초부터 검증한다.
AI_DAILY_REQUEST_LIMIT=
AI_MAX_OUTPUT_TOKENS=
AI_TIMEOUT_SECONDS=120
# true면 /docs·/openapi.json을 연다. 과제 배포 검증 뒤 닫고 싶으면 false/빈 값으로 둔다.
ENABLE_API_DOCS=

# ── 서버: Firebase · 단일 소유자 ──
# 서비스 계정 키 JSON 전체를 한 줄 문자열로. OWNER_UID는 첫 Google 로그인 후 확인한 UID.
FIREBASE_SERVICE_ACCOUNT_JSON=
OWNER_UID=

# ── 서버: CORS (쉼표로 구분한 허용 도메인) ──
ALLOWED_ORIGINS=
# 비우면 /docs(Swagger)를 끈다. 과제 제출처럼 공개가 필요할 때만 true.
ENABLE_API_DOCS=

# ── 서버: Telegram Bot 연동 (선택) ──
# BotFather에서 받은 봇 토큰. 채팅에는 붙여넣지 말고 Render 환경변수에만 넣는다.
TELEGRAM_BOT_TOKEN=
# /start로 받은 내 chat_id. 비워 두면 /start가 chat_id를 알려 주지만 일반 질문은 처리하지 않는다.
TELEGRAM_ALLOWED_CHAT_ID=
# setWebhook에 함께 넣는 임의의 긴 문자열. Telegram 요청 헤더 검증에 쓴다.
TELEGRAM_WEBHOOK_SECRET=

# ── 웹 공개 설정: 빌드·배포 과정에서 주입 (브라우저가 서버 환경변수를 읽지 않음) ──
API_BASE_URL=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
# 위 네 값으로 `node web/scripts/build-config.mjs`가 web/js/config.js(Git 제외)를 생성한다. 비밀값은 읽지 않는다.
