        "documentId": "YOUR_GOOGLE_SHEET_ID",
        "sheetName": "뉴스수집",
        "lookupColumn": "main_topic",
        "lookupValue": "={{$json.main_topic}}",
        "returnAllMatches": true
      },
      "id": "lookup-same-topic",
      "name": "Google Sheets - Lookup Same Topic",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1540, -60],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "YOUR_GOOGLE_SHEETS_CREDENTIAL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = items.map(item => item.json);\nconst current = rows[0];\nconst sameDateRows = rows.filter(row => row.received_date === current.received_date && row.main_topic === current.main_topic && row.processing_status !== 'DUPLICATE');\nconst newsletters = new Set(sameDateRows.map(row => String(row.newsletter_name || '').trim()).filter(Boolean));\nnewsletters.add(String(current.newsletter_name || '').trim());\nconst sourceCount = newsletters.size;\nconst issueLevel = sourceCount >= 3 ? '핵심' : sourceCount >= 2 ? '관심' : '일반';\nreturn [{ json: { ...current, source_count: sourceCount, issue_level: issueLevel, hot_issue: sourceCount >= 2, newsletters: Array.from(newsletters).join(', '), related_subjects: sameDateRows.map(row => row.subject).concat(current.subject).filter(Boolean).join('\\n') } }];"
      },
      "id": "calculate-source-count",
      "name": "Calculate Source Count",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, -60]
