      "id": "if-duplicate",
      "name": "IF Duplicate Message",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [880, -140]
    },
    {
      "parameters": {
        "jsCode": "const economic = new Set(['너겟레터','순살브리핑','데일리바이트','어피티']);\nconst general = new Set(['뉴닉','디그']);\nreturn items.map(item => {\n  const name = String(item.json.newsletter_name || '').trim();\n  const group = economic.has(name) ? '경제전문' : general.has(name) ? '종합시사' : '미분류';\n  return { json: { ...item.json, newsletter_name: name || '미분류', newsletter_group: group } };\n});"
      },
      "id": "detect-newsletter",
      "name": "Detect Newsletter Group",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, -60]
    },
    {
      "parameters": {
        "jsCode": "const map = {\n  '금리': ['금리','기준금리','금리 인하','금리 인상','연준','FOMC','통화정책'],\n  '환율': ['환율','원달러','원/달러','달러 강세','달러 약세','원화 강세','원화 약세'],\n  '주식시장': ['코스피','코스닥','증시','주식','나스닥','S&P500'],\n  '부동산': ['부동산','아파트','주택','전세','월세','주택 공급'],\n  '반도체': ['반도체','HBM','삼성전자','SK하이닉스','엔비디아'],\n  'AI': ['AI','인공지능','생성형 AI','AI 반도체'],\n  '물가': ['물가','인플레이션','소비자물가','CPI'],\n  '관세': ['관세','무역분쟁','무역전쟁'],\n  '가상자산': ['비트코인','가상자산','암호화폐','이더리움'],\n  '경기': ['경기침체','경기 회복','경제성장률','GDP','고용지표']\n};\nreturn items.map(item => {\n  const text = `${item.json.subject || ''}\\n${item.json.body || ''}`;\n  const matches = [];\n  for (const [topic, keywords] of Object.entries(map)) {\n    const found = keywords.filter(keyword => text.includes(keyword));\n    if (found.length) matches.push({ topic, found });\n  }\n  const secondary = [...new Set(matches.flatMap(m => m.found))];\n  return { json: { ...item.json, main_topic: matches[0]?.topic || '기타', secondary_keywords: secondary.join(', '), important_news: matches.length > 0 } };\n});"
      },
      "id": "classify-keywords",
      "name": "Classify Economic Keywords",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, -60]
    },
    {
      "parameters": {
